# ── Server ──────────────────────────────────────────────
PORT=4000
NODE_ENV=development
# The Vite dev server. Comma-separate to allow several origins.
CLIENT_ORIGIN=http://localhost:5173

# ── Security ────────────────────────────────────────────
# Signs session tokens. Use a long random string (e.g. `openssl rand -hex 32`).
JWT_SECRET=change-me-to-a-long-random-string
JWT_EXPIRES_IN=7d

# ── Storage ─────────────────────────────────────────────
# JSON file database, created on first run.
DATA_FILE=./data/db.json

# ── AI assistant ────────────────────────────────────────
# Leave AI_API_KEY empty to use the built-in mock assistant. For Groq, set
# AI_API_KEY and AI_MODEL in your local server/.env file; never put credentials
# in client/.env or commit them.
AI_API_KEY=
AI_BASE_URL=https://api.groq.com/openai/v1
AI_MODEL=
AI_TIMEOUT_MS=60000
# Model IDs change over time. Choose an active model from
# https://console.groq.com/docs/models and set it as AI_MODEL locally.
